---
import type { portfolioConfig } from "@/lib/types";

export interface Props {
    item: portfolioConfig;
}

const { item } = Astro.props;
const study = item.caseStudy;
const capabilities = item.brief?.capabilities ?? [];
const architecture = item.brief?.architecture ?? [];
---

{
    study && (
        <section class="border border-border border-t-0">
            <div class="p-6 md:p-10">
                <p class="text-xs font-mono tracking-[0.2em] uppercase text-muted-foreground">{study.eyebrow}</p>
                <h2 class="mt-4 max-w-3xl text-2xl md:text-4xl font-heading font-medium tracking-tight text-secondary-foreground">{study.title}</h2>
                <p class="mt-6 max-w-3xl text-base md:text-lg leading-relaxed text-muted-foreground">{study.lede}</p>

                <dl class="mt-10 grid grid-cols-1 sm:grid-cols-3 border border-border">
                    {study.facts.map((fact) => (
                        <div class="p-5 border-b last:border-b-0 sm:border-b-0 sm:border-r sm:last:border-r-0 border-border">
                            <dt class="text-xs tracking-widest uppercase text-muted-foreground">{fact.label}</dt>
                            <dd class="mt-2 text-sm leading-relaxed text-secondary-foreground">{fact.value}</dd>
                        </div>
                    ))}
                </dl>

                <div class="mt-6 grid grid-cols-2 lg:grid-cols-4 gap-px bg-border border border-border">
                    {study.metrics.map((metric) => (
                        <div class="bg-background p-5 md:p-6">
                            <p class="text-2xl md:text-3xl font-heading text-secondary-foreground">{metric.value}</p>
                            <p class="mt-2 text-xs tracking-wider uppercase text-muted-foreground">{metric.label}</p>
                            <p class="mt-3 text-xs leading-relaxed text-muted-foreground/80">{metric.detail}</p>
                        </div>
                    ))}
                </div>
            </div>

            <div class="border-t border-border">
                {study.sections.map((section, index) => (
                    <section class="grid grid-cols-1 md:grid-cols-[13rem_1fr] gap-6 md:gap-10 p-6 md:p-10 border-b border-border last:border-b-0">
                        <header>
                            <p class="text-xs tracking-[0.2em] text-muted-foreground">{String(index + 1).padStart(2, "0")}</p>
                            {section.kicker && <p class="mt-3 text-xs tracking-widest uppercase text-muted-foreground">{section.kicker}</p>}
                            <h3 class="mt-2 text-lg font-heading font-medium text-secondary-foreground">{section.title}</h3>
                        </header>
                        <div class="max-w-2xl">
                            <div class="space-y-4">
                                {section.paragraphs.map((paragraph) => (
                                    <p class="text-base leading-7 text-secondary-foreground/80">{paragraph}</p>
                                ))}
                            </div>
                            {section.bullets && section.bullets.length > 0 && (
                                <ul class="mt-6 grid gap-3">
                                    {section.bullets.map((bullet) => (
                                        <li class="flex gap-3 text-sm leading-6 text-muted-foreground">
                                            <span class="mt-2 size-1.5 shrink-0 bg-secondary-foreground/70" />
                                            <span>{bullet}</span>
                                        </li>
                                    ))}
                                </ul>
                            )}
                        </div>
                    </section>
                ))}
            </div>

            <div class="p-6 md:p-10 border-t border-border bg-muted/20">
                <p class="text-xs font-mono tracking-[0.2em] uppercase text-muted-foreground">Engineering notes</p>
                <h3 class="mt-3 text-xl font-heading font-medium text-secondary-foreground">关键工程工作</h3>
                <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-3">
                    {capabilities.map((capability) => (
                        <div class="p-5 border border-border bg-background text-sm leading-6 text-secondary-foreground/80">{capability}</div>
                    ))}
                </div>
                {architecture.length > 0 && (
                    <div class="mt-8 space-y-3">
                        {architecture.map((paragraph) => (
                            <p class="text-sm leading-7 text-muted-foreground">{paragraph}</p>
                        ))}
                    </div>
                )}
            </div>
        </section>
    )
}
